# ---------- Server ----------
PORT=8080
# Public HTTPS base URL of this service (Cloud Run URL or ngrok URL), no trailing slash.
# Used as the expected audience of Google-signed push/scheduler tokens.
PUBLIC_URL=

# ---------- Google ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Full Pub/Sub topic name that Gmail publishes to
GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/med-gmail
# Service accounts allowed to call /gmail/push and /tasks/* (comma-separated)
ALLOWED_INVOKERS=med-bridge-invoker@YOUR_PROJECT.iam.gserviceaccount.com
# Register the Gmail watch and run a catch-up sweep on startup
START_WATCH_ON_BOOT=true

# Gmail search that identifies MED notifications. The ingested label is excluded automatically.
GMAIL_MED_QUERY=from:transfeera.com subject:MED
GMAIL_INGESTED_LABEL=MED-Ingested

# ---------- ServiceNow ----------
SN_INSTANCE=https://devXXXXX.service-now.com
SN_USER=med.integration
SN_PASSWORD=
SN_TABLE=u_med_case
SN_ASSIGNMENT_GROUP=

# Basic auth credentials ServiceNow's flow uses to call /servicenow/send-reply.
# Must match the Basic Auth credential in ServiceNow's "MED Bridge" connection alias.
BRIDGE_USER=servicenow
BRIDGE_PASSWORD=

# ---------- Behaviour ----------
RESPONSE_DEADLINE_DAYS=3
SIGNATURE=Pix Global
